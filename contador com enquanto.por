programa
{
	
	funcao inicio()
	{
		inteiro contador=1, v_info, dobro
		escreva ("Informe um valor inteiro positivo: ")
		leia (v_info)
		enquanto (contador <= v_info){
		dobro = contador * 2
		escreva ("\n", contador , ". O dobro é:  ", dobro)
		contador++
		}
	}
}
